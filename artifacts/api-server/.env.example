# Core server
PORT=8080
DATABASE_PROVIDER=d1
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_TYPE=cloudflare-d1
DATABASE_BINDING=DB
DATABASE_NAME=main
DATABASE_ACCOUNT_ID=your_cloudflare_account_id
DATABASE_ID=your_d1_database_id
DATABASE_API_TOKEN=your_cloudflare_api_token
DATABASE_REGION=global
# One-time migration credentials for the separate question-bank account.
QB_D1_ACCOUNT_ID=your_question_bank_cloudflare_account_id
QB_D1_DATABASE_ID=your_question_bank_database_id
QB_D1_API_TOKEN=your_question_bank_cloudflare_api_token
# Main API Worker -> question-bank proxy Worker connection.
QB_PROXY_URL=https://rankpulse-qbank.your-subdomain.workers.dev
QB_PROXY_TOKEN=replace-with-a-long-random-shared-secret
# PYQ lives on a different Cloudflare account and uses its own Worker/D1.
PYQ_PROXY_URL=https://rankpulse-pyq.rankpulse-pyq.workers.dev
PYQ_PROXY_TOKEN=replace-with-a-different-long-random-shared-secret
# JAM Chemistry PYQs use a separate D1/Worker in the requested Cloudflare account.
JAM_D1_ACCOUNT_ID=c8cdcd5acfd39d60f7cfe7989d6a6608
JAM_D1_DATABASE_ID=replace-with-the-new-jam-d1-id
JAM_PYQ_PROXY_URL=https://rankpulse-jam-content.your-subdomain.workers.dev
JAM_PYQ_PROXY_TOKEN=replace-with-a-jam-content-shared-secret
JAM_QB_PROXY_URL=https://rankpulse-jam-content.your-subdomain.workers.dev
JAM_QB_PROXY_TOKEN=replace-with-a-jam-content-shared-secret
JAM_QB_CLASS_IDS=replace-with-the-jam-question-bank-class-id
# PSU lives on the dedicated PSU Worker/D1 in the separate Cloudflare account.
PSU_PROXY_URL=https://rankpulse-psu.workspace-psu-worker.workers.dev
PSU_PROXY_TOKEN=replace-with-another-long-random-shared-secret
# Also set SESSION_SECRET as a Cloudflare Worker secret (at least 32 random characters).
SESSION_SECRET=replace-this-with-a-long-random-secret
PUBLIC_APP_URL=https://your-railway-app.up.railway.app
# Workers AI runs through an account-local AI gateway for PYQ.
AI_HINT_PYQ_URL=https://rankpulse-pyq-ai.workspace-psu-worker.workers.dev
# Store AI_HINT_PYQ_TOKEN as a Worker secret; never expose it to the browser.
# Optional custom secret for signed reset links
# PASSWORD_RESET_LINK_SECRET=choose_a_long_random_secret
# Optional dedicated secret for student approval/rejection email links.
# Cloudflare Worker falls back to its configured GMAIL_APP_PASSWORD if omitted.
# STUDENT_REVIEW_EMAIL_ACTION_SECRET=choose_a_long_random_secret

# New Google-created student accounts: approved or pending
FIREBASE_GOOGLE_NEW_STUDENT_STATUS=pending

# Razorpay payment setup
# Keep live secrets only in Railway/local env, never in committed code.
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret


# Firebase Admin setup
# Use one of the options below.

# Optional for token verification fallback when Firebase Admin credentials
# are not available. This enables Firebase email/password and Google login
# verification using Firebase Identity Toolkit.
# FIREBASE_WEB_API_KEY=your_firebase_web_api_key

# Option A: service account file path
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json

# Option B: individual service account fields
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Option C: full service account JSON as one env var
# Required as a Worker secret for Gmail SMTP password-reset links (or use all Option B fields).
# The service account needs Firebase Authentication permissions, including firebaseauth.users.sendEmail.
# Gmail delivery also requires Worker secrets GMAIL_USER and GMAIL_APP_PASSWORD; use a Gmail app password.
PYQ_EMAIL_ACTION_SECRET=replace-with-a-long-random-secret
# FIREBASE_SERVICE_ACCOUNT_JSON={"projectId":"your-firebase-project-id","clientEmail":"firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com","privateKey":"-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n"}
